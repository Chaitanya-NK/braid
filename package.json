{
  "name": "braid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,sync,ports -c cyan,magenta,gray \"npm:dev:web\" \"npm:dev:sync\" \"npm:ports:public\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:sync": "tsx watch server/sync.ts",
    "sync": "tsx server/sync.ts",
    "ports:public": "bash .devcontainer/ports-public.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hocuspocus/extension-database": "^4.8.0",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-collaboration-caret": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
