# ---------------------------------------------------------------------------
# Local development (Codespaces). setup.sh copies this to .env.
# ---------------------------------------------------------------------------

# Postgres connection. In Codespaces the database runs in the "db" container.
DATABASE_URL=postgres://braid:braid@db:5432/braid

# Secret used to sign sessions and sync tickets. setup.sh fills this in.
# To make one yourself: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Optional. Leave empty in Codespaces and on Vercel: the app works out its own
# URL. Set it to your custom domain if you add one (e.g. https://braid.example.com).
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Deployed (see docs/DEPLOY.md). Set these in Vercel / Render, not here.
# ---------------------------------------------------------------------------

# Vercel:  DATABASE_URL = Supabase "Transaction pooler" string (port 6543)
#          BETTER_AUTH_SECRET = same as Render
#          NEXT_PUBLIC_SYNC_URL = wss://<your-render-service>.onrender.com
# Render:  DATABASE_URL = Supabase "Session pooler" string (port 5432)
#          BETTER_AUTH_SECRET = same as Vercel
# Migrations (run once from Codespaces):
#          MIGRATION_DATABASE_URL = Supabase "Session pooler" string (port 5432)
NEXT_PUBLIC_SYNC_URL=
MIGRATION_DATABASE_URL=
