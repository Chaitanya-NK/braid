# Postgres connection. In Codespaces the database runs in the "db" container.
DATABASE_URL=postgres://braid:braid@db:5432/braid

# Secret used to sign sessions. setup.sh fills this in automatically.
# To make one yourself: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Optional. Leave empty in Codespaces: the app works out its own URL.
BETTER_AUTH_URL=
